<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboot_maven.mapper.News01Dao">

    <select id="getNewsById" resultType="com.example.springboot_maven.pojo.News">
        select * from news where id = #{id}
    </select>


    <select id="getAllNews" resultType="com.example.springboot_maven.pojo.News">
        select * from news
    </select>

<!--    新增-->
<!--    方式一-->
    <insert id="insertNews" parameterType="com.example.springboot_maven.pojo.News">
        insert into news
            (id, title, author)
        values (#{id},
                #{title},
                #{author})
    </insert>
<!--    方式二-->
    <insert id="addNews" parameterType="com.example.springboot_maven.pojo.News">
        insert into news
        <trim prefix="(" suffix=")" suffixOverrides=",">

            <if test="title != null">
                title,
            </if>
            <if test="author != null">
                author
            </if>
            <!-- 其他字段 -->
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="title != null">
                #{title},
            </if>
            <if test="author != null">
                #{author}
            </if>
            <!-- 其他字段对应的值 -->
        </trim>
    </insert>
<!--    编辑-->
    <update id="updateNews" parameterType="com.example.springboot_maven.pojo.News">
        update news
        <set>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="author != null">
                author = #{author,jdbcType=VARCHAR},
            </if>
        </set>
        where id = #{id,jdbcType=BIGINT}
    </update>


<!--删除-->
    <delete id="deleteNews" parameterType="integer">
        delete
        from news
        where id = #{id}
    </delete>

</mapper>